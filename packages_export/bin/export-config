#!/home/sid/ennovo-compost-widget/.venv/bin/python3
# -*- coding: utf-8 -*-
import sys
from ennovo_compost_widget.app_config import export
if __name__ == "__main__":
    if sys.argv[0].endswith("-script.pyw"):
        sys.argv[0] = sys.argv[0][:-11]
    elif sys.argv[0].endswith(".exe"):
        sys.argv[0] = sys.argv[0][:-4]
    sys.exit(export())
